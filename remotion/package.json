{
  "name": "tasktracker-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion induction videos for the Task Tracker platform",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts InductionFull out/induction.mp4",
    "render:preview": "remotion render src/index.ts InductionFull out/induction.mp4 --quality=70 --concurrency=4",
    "still": "remotion still src/index.ts InductionFull out/poster.png --frame=60"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@remotion/tailwind-v4": "^4.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
